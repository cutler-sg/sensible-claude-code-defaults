{
  "name": "sensible-claude-code-defaults",
  "displayName": "Sensible Claude Code Defaults",
  "description": "Set up and health-check Claude Code on AWS Bedrock: sensible defaults, guided Bedrock API key setup, and a panel that says what is wrong. An independent tool, not affiliated with Anthropic, PBC.",
  "publisher": "cutler-sg",
  "version": "0.2.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cutler-sg/sensible-claude-code-defaults.git"
  },
  "homepage": "https://cutler.sg/sensible-claude-code-defaults",
  "bugs": {
    "url": "https://github.com/cutler-sg/sensible-claude-code-defaults/issues"
  },
  "keywords": [
    "claude",
    "claude code",
    "anthropic",
    "bedrock",
    "amazon bedrock",
    "aws",
    "configuration",
    "settings",
    "credentials",
    "health check"
  ],
  "qna": "https://github.com/cutler-sg/sensible-claude-code-defaults/issues",
  "icon": "media/icon.png",
  "categories": [
    "AI",
    "Machine Learning",
    "Other"
  ],
  "galleryBanner": {
    "color": "#0B2F38",
    "theme": "dark"
  },
  "preview": true,
  "engines": {
    "vscode": "^1.98.0"
  },
  "extensionDependencies": [
    "anthropic.claude-code"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "restrictedConfigurations": [
        "sensibleDefaults.manifestUrl"
      ]
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sensibleDefaults",
          "title": "Sensible Defaults",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "sensibleDefaults": [
        {
          "type": "webview",
          "id": "sensibleDefaults.health",
          "name": "Claude Code on Bedrock"
        },
        {
          "id": "sensibleDefaults.details",
          "name": "Details",
          "when": "sensibleDefaults.detailsOpen"
        }
      ]
    },
    "commands": [
      {
        "command": "sensibleDefaults.enableWindowsTerminalCli",
        "title": "Enable Claude in VS Code Terminals",
        "category": "Sensible Defaults"
      },
      {
        "command": "sensibleDefaults.disableWindowsTerminalCli",
        "title": "Disable Claude Terminal Repair",
        "category": "Sensible Defaults"
      },
      {
        "command": "sensibleDefaults.runHealthCheck",
        "title": "Check Configuration",
        "category": "Sensible Defaults",
        "icon": "$(refresh)"
      },
      {
        "command": "sensibleDefaults.applyDefaults",
        "title": "Apply Recommended Configuration",
        "category": "Sensible Defaults",
        "icon": "$(wand)"
      },
      {
        "command": "sensibleDefaults.checkForUpdates",
        "title": "Check for Updated Recommendations",
        "category": "Sensible Defaults"
      },
      {
        "command": "sensibleDefaults.openSettings",
        "title": "Open settings.json",
        "category": "Sensible Defaults"
      },
      {
        "command": "sensibleDefaults.restoreBackup",
        "title": "Restore Previous Configuration",
        "category": "Sensible Defaults"
      },
      {
        "command": "sensibleDefaults.copyDiagnostics",
        "title": "Copy Diagnostics for Support",
        "category": "Sensible Defaults"
      },
      {
        "command": "sensibleDefaults.setToken",
        "title": "Set Bedrock API Key",
        "category": "Sensible Defaults"
      },
      {
        "command": "sensibleDefaults.rotateToken",
        "title": "Update Bedrock API Key",
        "category": "Sensible Defaults"
      },
      {
        "command": "sensibleDefaults.clearToken",
        "title": "Remove Bedrock API Key",
        "category": "Sensible Defaults"
      },
      {
        "command": "sensibleDefaults.testConnection",
        "title": "Test Bedrock Connection",
        "category": "Sensible Defaults"
      },
      {
        "command": "sensibleDefaults.adoptToken",
        "title": "Use the key from my settings file",
        "category": "Sensible Defaults"
      },
      {
        "command": "sensibleDefaults.reapplyToken",
        "title": "Copy the key into my settings file",
        "category": "Sensible Defaults"
      },
      {
        "command": "sensibleDefaults.resolveTokenConflict",
        "title": "Resolve API key conflict",
        "category": "Sensible Defaults"
      },
      {
        "command": "sensibleDefaults.selectRegion",
        "title": "Change AWS Region",
        "category": "Sensible Defaults"
      },
      {
        "command": "sensibleDefaults.repairPermissions",
        "title": "Repair File Permissions",
        "category": "Sensible Defaults"
      },
      {
        "command": "sensibleDefaults.resetKey",
        "title": "Reset to Recommended",
        "category": "Sensible Defaults",
        "icon": "$(discard)"
      },
      {
        "command": "sensibleDefaults.runFix",
        "title": "Fix This",
        "category": "Sensible Defaults",
        "icon": "$(wrench)"
      },
      {
        "command": "sensibleDefaults.openLeakedFile",
        "title": "Open the file your key was found in",
        "category": "Sensible Defaults"
      }
    ],
    "configuration": {
      "title": "Sensible Defaults",
      "properties": {
        "sensibleDefaults.enableWindowsTerminalCli": {
          "type": "boolean",
          "scope": "application",
          "default": false,
          "description": "On Windows, add the verified Claude Code extension binary directory to new VS Code terminals when no existing Claude command is found. Does not change the system PATH or external terminals."
        },
        "sensibleDefaults.manifestUrl": {
          "type": "string",
          "scope": "application",
          "default": "https://raw.githubusercontent.com/cutler-sg/sensible-claude-code-defaults/main/manifest/defaults.json",
          "description": "URL of the defaults manifest. Falls back to the cached and then the bundled copy when unreachable."
        },
        "sensibleDefaults.checkOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Run configuration health checks when the window finishes starting up."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "sensibleDefaults.runHealthCheck",
          "when": "view == sensibleDefaults.details",
          "group": "navigation"
        },
        {
          "command": "sensibleDefaults.applyDefaults",
          "when": "view == sensibleDefaults.details",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "sensibleDefaults.runFix",
          "when": "view == sensibleDefaults.details && viewItem == check:command",
          "group": "inline"
        },
        {
          "command": "sensibleDefaults.resetKey",
          "when": "view == sensibleDefaults.details && viewItem == drift",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "sensibleDefaults.runFix",
          "when": "false"
        },
        {
          "command": "sensibleDefaults.resetKey",
          "when": "false"
        },
        {
          "command": "sensibleDefaults.openLeakedFile",
          "when": "false"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "sensibleDefaults.details",
        "contents": "Checking your Claude Code configuration…",
        "when": "sensibleDefaults.hasReport == false"
      },
      {
        "view": "sensibleDefaults.details",
        "contents": "Nothing to show until Claude Code is set up.",
        "when": "view == sensibleDefaults.details && sensibleDefaults.needsSetup"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "test": "vitest run",
    "package": "node esbuild.js --production && vsce package --no-dependencies",
    "vscode:prepublish": "node esbuild.js --production",
    "test:integration": "node esbuild.js && esbuild test/integration-vscode/*.spec.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --external:mocha --outdir=out/test/integration-vscode && vscode-test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.5.0",
    "@types/vscode": "~1.98.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.7.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.3",
    "mocha": "^12.0.0",
    "ovsx": "^1.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
